#include <windows.h>
#define IDI_APP 100
1 24 "launcher.manifest"
; IDI_APP ICON "app.ico" — icon file not shipped in the public repo snapshot.
; Re-add launcher\app.ico and uncomment to restore the custom icon.
1 VERSIONINFO
FILEVERSION 1,1,0,0
PRODUCTVERSION 1,1,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "ZidWindowsApps"
      VALUE "ProductName", "ZidWindowsApps"
      VALUE "FileVersion", "1.1.0.0"
      VALUE "ProductVersion", "1.1.0.0"
      VALUE "OriginalFilename", "ZidWindowsApps.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
